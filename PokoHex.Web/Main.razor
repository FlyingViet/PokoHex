@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>PokoHex@(SAV == null ? "" : $" / {SaveName}")</PageTitle>
<main @ref="EditorWindow" class="application" aria-busy="@Busy">
    <header class="titlebar"><strong>PokoHex</strong><span>Save Editor</span><a class="edition" href="https://github.com/berichan/PokoHex" target="_blank" rel="noopener noreferrer">Source</a></header>
    <div class="menubar">
        <label class="file-button" aria-disabled="@Busy">Open save folder…
            <InputFile id="open-folder" OnChange="OpenFolder" webkitdirectory="" multiple disabled="@Busy" />
        </label>
        <label class="file-button" aria-disabled="@Busy">Open ZIP…
            <InputFile id="open-zip" OnChange="OpenZip" accept=".zip" disabled="@Busy" />
        </label>
        <button @onclick="Menu_Export_Click" disabled="@(SAV == null || Busy)">Export save copy…</button>
        <label class="language">Language:
            <select aria-label="Catalog language" value="@Language" @onchange="Menu_Language_Changed" disabled="@Busy">
                @for (int i = 0; i < GameLanguage.LanguageCount; i++)
                {
                    <option value="@i">@LanguageNames[i]</option>
                }
            </select>
        </label>
    </div>
    @if (Error.Length != 0)
    {
        <div class="error" role="alert"><span>@Error</span><button @onclick="() => Error = string.Empty" aria-label="Dismiss error">×</button></div>
    }
    <nav class="tabs" aria-label="Editor tabs">
        @foreach (var tab in Tabs)
        {
            <button class="@(SelectedTab == tab ? "active" : "")" aria-current="@(SelectedTab == tab ? "page" : null)" disabled="@Busy" @onclick="() => SelectTab(tab)">@tab</button>
        }
    </nav>
    <section class="workspace" inert="@(Busy ? string.Empty : null)">
        @if (SAV == null)
        {
            <div class="welcome">
                <h1>PokoHex Save Editor</h1>
                <p>Open or drag in the save folder containing <strong>G00</strong> and <strong>S00</strong>, or a ZIP of that folder.</p>
                <p class="muted">Everything happens locally. Your save files stay in your browser. Export downloads a ZIP; your original files are never overwritten but keep backups!</p>
            </div>
        }
        else
        {
            <div @key="SAV" class="editors" @onchange="Controls_Changed" @onclick="Controls_Changed">
                <section hidden="@(SelectedTab != "Player")" class="player-editor">
                    <div class="player-header">
                        <label for="player-name">Player name:</label>
                        <input id="player-name" @bind="PlayerName" @bind:event="oninput" />
                        <label for="life-coins">Life Coins:</label>
                        <input id="life-coins" type="number" min="0" max="@SaveFile.MaxLifeCoins" step="1" @bind="LifeCoins" @bind:event="oninput"
                               disabled="@(!SAV.Common.HasLifeCoins)" title="@(SAV.Common.HasLifeCoins ? $"0 to {SaveFile.MaxLifeCoins:N0}" : "Not available for this save version")" />
                        <div class="player-sections" role="group" aria-label="Player editor">
                            <button aria-pressed="@(PlayerSection == "Skills")" @onclick='() => PlayerSection = "Skills"'>Skills</button>
                            <button aria-pressed="@(PlayerSection == "Reactions")" @onclick='() => PlayerSection = "Reactions"'>Reactions</button>
                        </div>
                    </div>
                    <section hidden="@(PlayerSection != "Skills")"><AbilityEditor @ref="Editor_Skills" SAV="SAV.Common" Language="Language" Active="@(SelectedTab == "Player" && PlayerSection == "Skills")" Error="ShowError" Changed="Controls_Changed" /></section>
                    <section hidden="@(PlayerSection != "Reactions")"><AbilityEditor @ref="Editor_Reactions" SAV="SAV.Common" Reactions="true" Language="Language" Active="@(SelectedTab == "Player" && PlayerSection == "Reactions")" Error="ShowError" Changed="Controls_Changed" /></section>
                </section>
                <section hidden="@(SelectedTab != "Items")"><InventoryEditor @ref="Editor_Items" SAV="SAV.Common" Language="Language" Active="@(SelectedTab == "Items")" Error="ShowError" Changed="Controls_Changed" /></section>
                <section hidden="@(SelectedTab != "Villagers")"><VillagerEditor @ref="Editor_Villagers" SAV="SAV.Common" Language="Language" Active="@(SelectedTab == "Villagers")" Error="ShowError" Changed="Controls_Changed" /></section>
                <section hidden="@(SelectedTab != "Flags")"><FlagEditor @ref="Editor_Flags" SAV="SAV.Common" Language="Language" Active="@(SelectedTab == "Flags")" Error="ShowError" Changed="Controls_Changed" /></section>
                @if (MapOpened)
                {
                    <section hidden="@(SelectedTab != "Map")"><MapEditor @ref="Editor_Map" SAV="SAV" Language="Language" Active="@(SelectedTab == "Map")" Error="ShowError" Changed="Controls_Changed" /></section>
                }
            </div>
        }
    </section>
    <footer class="statusbar" role="status"><span>@Status</span><span>@(SAV == null ? "Local save editing" : HasChanges ? "Unsaved changes" : "No pending changes")</span></footer>
    <div class="drop-target" aria-hidden="true"><span>Drop a save folder or ZIP to open it.</span></div>
    @if (Busy)
    {
        <div class="busy" role="status">@Status</div>
    }
</main>
